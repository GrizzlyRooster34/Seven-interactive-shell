# Seven Runtime Configuration
SEVEN_MODE=dev
# Options: dev (Mock/Echo), prod (Real AI)

# Substrate Keys
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Asset Paths (For Local File System)
